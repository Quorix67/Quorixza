<script>

/* =========================================================
   BASIC ELEMENTS
========================================================= */

const home = document.getElementById('home');
const browserView = document.getElementById('browser');

const searchForm = document.getElementById('searchForm');
const searchInput = document.getElementById('searchInput');

const addrText = document.getElementById('addrText');
const openNewTab = document.getElementById('openNewTab');

openNewTab.target = '_blank';
openNewTab.rel = 'noopener noreferrer';

const siteFrame = document.getElementById('siteFrame');
const frameNote = document.getElementById('frameNote');

const backBtn = document.getElementById('backBtn');
const navStatus = document.getElementById('navStatus');


/* =========================================================
   URL DETECTION
========================================================= */

function looksLikeUrl(v) {

  const s = v.trim();

  if (/^https?:\/\//i.test(s)) {
    return true;
  }

  return /^[a-z0-9-]+(\.[a-z0-9-]+)+([/?#].*)?$/i.test(s)
    && !s.includes(' ');
}


/* =========================================================
   HISTORY
========================================================= */

const historySettingsBtn =
  document.getElementById('historySettingsBtn');

const historyOverlay =
  document.getElementById('historyOverlay');

const historyClose =
  document.getElementById('historyClose');

const historyList =
  document.getElementById('historyList');

const clearHistoryBtn =
  document.getElementById('clearHistoryBtn');

let quorixHistory = [];


function loadHistory() {

  try {

    const saved =
      localStorage.getItem('quorix_history');

    quorixHistory =
      saved ? JSON.parse(saved) : [];

    if (!Array.isArray(quorixHistory)) {
      quorixHistory = [];
    }

  } catch {

    quorixHistory = [];

  }

}


function saveHistory() {

  try {

    localStorage.setItem(
      'quorix_history',
      JSON.stringify(quorixHistory)
    );

  } catch {}

}


function addHistory(value) {

  value = String(value || '').trim();

  if (!value) return;

  if (value === 'about:blank') return;

  const title = tabTitle(value);

  /* Remove duplicate */
  quorixHistory =
    quorixHistory.filter(item => item.url !== value);

  /* Add newest item at the top */
  quorixHistory.unshift({

    title: title,

    url: value,

    time: Date.now()

  });

  /* Keep maximum of 100 items */
  quorixHistory =
    quorixHistory.slice(0, 100);

  saveHistory();

}


function formatHistoryTime(timestamp) {

  const date = new Date(timestamp);
  const now = new Date();

  const diff = now - date;

  if (diff < 60 * 1000) {
    return 'Just now';
  }

  if (diff < 60 * 60 * 1000) {

    return Math.floor(
      diff / (60 * 1000)
    ) + 'm ago';

  }

  if (diff < 24 * 60 * 60 * 1000) {

    return Math.floor(
      diff / (60 * 60 * 1000)
    ) + 'h ago';

  }

  if (diff < 7 * 24 * 60 * 60 * 1000) {

    return Math.floor(
      diff / (24 * 60 * 60 * 1000)
    ) + 'd ago';

  }

  return date.toLocaleDateString();

}


function renderHistory() {

  if (!quorixHistory.length) {

    historyList.innerHTML = `

      <div class="history-empty">

        <div style="font-size:28px;margin-bottom:10px;">
          🕘
        </div>

        No browsing history yet.

        <br>

        Websites and searches you use in Quorix
        will appear here.

      </div>

    `;

    return;

  }

  historyList.innerHTML = '';

  quorixHistory.forEach(item => {

    const button =
      document.createElement('button');

    button.type = 'button';

    button.className = 'history-item';


    const icon =
      document.createElement('div');

    icon.className = 'history-icon';

    icon.textContent =
      looksLikeUrl(item.url)
        ? '↗'
        : '⌕';


    const info =
      document.createElement('div');

    info.className = 'history-info';


    const title =
      document.createElement('div');

    title.className = 'history-title';

    title.textContent =
      item.title || item.url;


    const url =
      document.createElement('div');

    url.className = 'history-url';

    url.textContent = item.url;


    info.appendChild(title);
    info.appendChild(url);


    const time =
      document.createElement('div');

    time.className = 'history-time';

    time.textContent =
      formatHistoryTime(item.time);


    button.appendChild(icon);
    button.appendChild(info);
    button.appendChild(time);


    button.addEventListener('click', () => {

      setHistoryMenu(false);

      searchInput.value = item.url;

      navigate(item.url);

    });


    historyList.appendChild(button);

  });

}


function setHistoryMenu(open) {

  historyOverlay.classList.toggle(
    'open',
    open
  );

  historyOverlay.setAttribute(
    'aria-hidden',
    String(!open)
  );

  if (open) {

    renderHistory();

    historyClose.focus();

  }

}


/* History button */

historySettingsBtn.addEventListener(
  'click',
  () => {

    setSettingsMenu(false);

    setHistoryMenu(true);

  }
);


/* Close */

historyClose.addEventListener(
  'click',
  () => setHistoryMenu(false)
);


/* Click outside */

historyOverlay.addEventListener(
  'click',
  e => {

    if (e.target === historyOverlay) {

      setHistoryMenu(false);

    }

  }
);


/* Clear history */

clearHistoryBtn.addEventListener(
  'click',
  () => {

    if (!quorixHistory.length) {
      return;
    }

    const confirmed =
      confirm(
        'Clear all Quorix browsing history?'
      );

    if (!confirmed) {
      return;
    }

    quorixHistory = [];

    saveHistory();

    renderHistory();

  }
);


/* Escape */

document.addEventListener(
  'keydown',
  e => {

    if (
      e.key === 'Escape' &&
      historyOverlay.classList.contains('open')
    ) {

      setHistoryMenu(false);

    }

  }
);


/* Load history immediately */

loadHistory();


/* =========================================================
   QUARKTION / QUORIXTUBE
========================================================= */

const qtube =
  document.getElementById('qtube');

const qtAccount =
  document.getElementById('qtAccount');

