  document.getElementById('qtFileName');

const qtTitleInput =
  document.getElementById('qtTitleInput');

const qtVideosTab =
  document.getElementById('qtVideosTab');

const qtSearchTab =
  document.getElementById('qtSearchTab');

const qtVideosView =
  document.getElementById('qtVideosView');

const qtSearchView =
  document.getElementById('qtSearchView');

const qtSearchForm =
  document.getElementById('qtSearchForm');

const qtSearchInput =
  document.getElementById('qtSearchInput');

const qtSearchResults =
  document.getElementById('qtSearchResults');

const qtSearchEmpty =
  document.getElementById('qtSearchEmpty');


let qtChannelData = null;

let qtVideos = [];

const qtBlobs = {};

let qtPendingFile = null;


function qtLoad() {

  try {

    const c =
      localStorage.getItem(
        'quorix_channel'
      );

    const v =
      localStorage.getItem(
        'quorix_videos'
      );

    qtChannelData =
      c ? JSON.parse(c) : null;

    qtVideos =
      v ? JSON.parse(v) : [];

  } catch {

    qtChannelData = null;
    qtVideos = [];

  }

}


function qtSaveChannel() {

  try {

    localStorage.setItem(
      'quorix_channel',
      JSON.stringify(qtChannelData)
    );

  } catch {}

}


function qtSaveVideos() {

  try {

    localStorage.setItem(
      'quorix_videos',
      JSON.stringify(qtVideos)
    );

  } catch {}

}


function qtRenderGrid() {

  qtEmpty.style.display =
    qtVideos.length
      ? 'none'
      : 'block';

  qtGrid.innerHTML =
    qtVideos
      .slice()
      .reverse()
      .map(v => {

        const blob =
          qtBlobs[v.id];

        const media = blob

          ? `<video src="${blob}" controls preload="metadata"></video>`

          : `
            <div class="qt-thumb-empty">
              Video unavailable after reload — this browser tab isn't
              storing the actual file, only its title. Re-publish to watch
              it again.
            </div>
          `;

        return `

          <div class="qt-card">

            ${media}

            <p class="qt-title">
              ${v.title}
            </p>

            <p class="qt-meta">
              ${qtChannelData.name} · ${v.date}
            </p>

          </div>

        `;

      })
      .join('');

  if (
    qtSearchView.classList.contains('active')
  ) {

    qtRenderSearchResults(
      qtSearchInput.value
    );

  }

}


function qtRenderSearchResults(query = '') {

  const q =
    query.trim().toLowerCase();

  const matches =
    q

      ? qtVideos.filter(v =>
          `${v.title} ${qtChannelData?.name || ''}`
            .toLowerCase()
            .includes(q)
        )

      : [];

  qtSearchEmpty.style.display =
    matches.length
      ? 'none'
      : 'block';

  if (!q) {

    qtSearchEmpty.textContent =
      'Enter a search to find videos.';

    qtSearchResults.innerHTML = '';

    return;

  }

  qtSearchEmpty.textContent =
    matches.length
      ? ''
      : 'No videos matched your search.';

  qtSearchResults.innerHTML =
    matches
      .slice()
      .reverse()
      .map(v => {

        const blob =
          qtBlobs[v.id];

        const media = blob

          ? `<video src="${blob}" controls preload="metadata"></video>`

          : `<div class="qt-search-thumb-empty"></div>`;

        return `

          <div class="qt-search-card">

            ${media}

            <div class="qt-search-info">

              <p class="qt-title">
                ${v.title}
              </p>

              <p class="qt-meta">
                ${qtChannelData?.name || 'Quarktion'} · ${v.date}
              </p>

              <p class="qt-meta">
                Video saved in this browser session.
              </p>

            </div>

          </div>

        `;

      })
      .join('');

}


function qtSetView(view) {

  const search =
    view === 'search';

  qtVideosView.classList.toggle(
    'active',
    !search
  );

  qtSearchView.classList.toggle(
    'active',
    search
  );

  qtVideosTab.classList.toggle(
    'active',
    !search
  );

  qtSearchTab.classList.toggle(
    'active',
    search
  );

  if (search) {

    qtSearchInput.focus();

    qtRenderSearchResults(
      qtSearchInput.value
    );

  }

}


qtVideosTab.addEventListener(
  'click',
  () => qtSetView('videos')
);


qtSearchTab.addEventListener(
  'click',
  () => qtSetView('search')
);


qtSearchForm.addEventListener(
  'submit',
  e => {

    e.preventDefault();

    qtRenderSearchResults(
      qtSearchInput.value
    );

  }
);


function showQtube() {

  qtLoad();

  qtSetView('videos');

  if (
    qtChannelData &&
    qtChannelData.name
  ) {

    qtAccount.style.display =
      'none';

    qtChannel.style.display =
      'block';

    qtChannelName.textContent =
      qtChannelData.name;

    qtRenderGrid();

  } else {

    qtAccount.style.display =
      'block';

    qtChannel.style.display =
      'none';

  }

  addrText.textContent =
    'quorix://quarktion.quorix';

  openNewTab.style.display =
    'none';

  siteFrame.style.display =
    'none';

  frameNote.style.display =
    'none';

  qtube.style.display =
    'block';

}


function hideQtube() {

  qtube.style.display =
    'none';

  siteFrame.style.display =
    'block';

  frameNote.style.display =
    'block';

}


document
  .getElementById('qtCreateAccount')
  .addEventListener(
    'click',
    () => {

      const name =
        qtChannelInput.value.trim();

      if (!name) {

        qtChannelInput.focus();

        return;

      }

      qtChannelData = {
        name
      };

      qtSaveChannel();

      showQtube();

    }
  );


document
  .getElementById('openStudio')
  .addEventListener(
    'click',
    () => {

      qtTitleInput.value = '';

      qtFileName.textContent = '';

      qtPendingFile = null;

      qtFileInput.value = '';

      qtOverlay.classList.add('open');

    }
  );


document
  .getElementById('qtCancel')
  .addEventListener(
    'click',
    () => qtOverlay.classList.remove('open')
  );


qtOverlay.addEventListener(
  'click',
  e => {

    if (e.target === qtOverlay) {

      qtOverlay.classList.remove('open');

    }

  }
);


qtFileDrop.addEventListener(
  'click',
  () => qtFileInput.click()
);


qtFileInput.addEventListener(
  'change',
  () => {

    qtPendingFile =
      qtFileInput.files[0] || null;

    qtFileName.textContent =
      qtPendingFile
        ? qtPendingFile.name
        : '';

  }
);


document
  .getElementById('qtPublish')
  .addEventListener(
    'click',
    () => {

      const title =
        qtTitleInput.value.trim();

      if (!title) {

        qtTitleInput.focus();

        return;

      }

      if (!qtPendingFile) {

        qtFileDrop.focus();

        return;

      }

      const id =
        'v' + Date.now();

      qtBlobs[id] =
        URL.createObjectURL(
          qtPendingFile
        );

      qtVideos.push({

        id,

        title,

        date: 'just now'

      });

      qtSaveVideos();

      qtRenderGrid();

      qtOverlay.classList.remove(
        'open'
      );

    }
  );


/* =========================================================
   SETTINGS / THEMES
========================================================= */

const settingsDock =
  document.getElementById('settingsDock');

const settingsToggle =
  document.getElementById('settingsToggle');

const settingsOverlay =
  document.getElementById('settingsOverlay');

const settingsClose =
  document.getElementById('settingsClose');

const themeOptions =
  Array.from(
    document.querySelectorAll('.theme-option')
  );

let currentTheme = 'system';


function applyTheme(
  theme,
  persist = true
) {

  currentTheme =
    [
      'system',
      'light',
      'dark',
      'midnight',
      'ocean',
      'purple',
      'sunset',
      'rose',
      'forest'
    ].includes(theme)

      ? theme

      : 'system';


  if (currentTheme === 'system') {

    document.documentElement
      .removeAttribute('data-theme');

  } else {

    document.documentElement
      .setAttribute(
        'data-theme',
        currentTheme
      );

  }


  themeOptions.forEach(btn => {

    btn.classList.toggle(
      'active',
      btn.dataset.themeChoice ===
        currentTheme
    );

  });


  if (persist) {

    try {

      localStorage.setItem(
        'quorix_theme',
        currentTheme
      );

    } catch {}

  }

}


function setSettingsMenu(open) {

  settingsOverlay.classList.toggle(
    'open',
    open
  );

  settingsToggle.classList.toggle(
    'active',
    open
  );

  settingsToggle.setAttribute(
    'aria-expanded',
    String(open)
  );

  settingsOverlay.setAttribute(
    'aria-hidden',
    String(!open)
  );

  if (open) {

    settingsClose.focus();

  }

}


settingsToggle.addEventListener(
  'click',
  () => {

    setSettingsMenu(
      !settingsOverlay.classList.contains('open')
    );

  }
);


settingsClose.addEventListener(
  'click',
  () => setSettingsMenu(false)
);


settingsOverlay.addEventListener(
  'click',
  e => {

    if (e.target === settingsOverlay) {

      setSettingsMenu(false);

    }

  }
);


document.addEventListener(
  'keydown',
  e => {

    if (
      e.key === 'Escape' &&
      settingsOverlay.classList.contains('open')
    ) {

      setSettingsMenu(false);

    }

  }
);


themeOptions.forEach(btn => {

  btn.addEventListener(
    'click',
    () => applyTheme(
      btn.dataset.themeChoice
    )
  );

});


try {

  applyTheme(
    localStorage.getItem('quorix_theme') ||
      'system',
    false
  );

} catch {

  applyTheme(
    'system',
    false
  );

}


/* =========================================================
   SAVE / IMPORT
========================================================= */

const saveDock =
  document.getElementById('saveDock');

const saveToggle =
  document.getElementById('saveToggle');

const exportSaveBtn =
  document.getElementById('exportSaveBtn');

const importSaveBtn =
  document.getElementById('importSaveBtn');

const importSaveInput =
  document.getElementById('importSaveInput');

const saveStatus =
  document.getElementById('saveStatus');


saveToggle.addEventListener(
  'click',
  () => {

    const open =
      saveDock.classList.toggle(
        'open'
      );

    saveToggle.setAttribute(
      'aria-expanded',
      String(open)
    );

  }
);


function getSaveData() {

  return {

    app: 'Quorix',

    version: 1,

    exportedAt:
      new Date().toISOString(),

    tabs: tabs.map(t => ({

      id:
        String(t.id || ''),

      title:
        String(t.title || 'New Tab'),

      url:
        String(t.url || ''),

      internal:
        Boolean(t.internal)

    })),

    activeTabId:
      activeTabId
        ? String(activeTabId)
        : null,

    tabCounter:
      Number.isFinite(tabCounter)
        ? tabCounter
        : 0,

    theme:
      currentTheme,

    history:
      quorixHistory,

    quarktion: {

      channel:
        qtChannelData,

      videos:
        Array.isArray(qtVideos)
          ? qtVideos
          : []

    }

  };

}


function downloadText(
  filename,
  text,
  type = 'application/json'
) {

  const blob =
    new Blob(
      [text],
      {type}
    );

  const url =
    URL.createObjectURL(blob);

  const a =
    document.createElement('a');

  a.href = url;

  a.download =
    filename;

  document.body.appendChild(a);

  a.click();

  a.remove();

  setTimeout(
    () => URL.revokeObjectURL(url),
    1000
  );

}


exportSaveBtn.addEventListener(
  'click',
  () => {

    try {

      const data =
        getSaveData();

      const stamp =
        new Date()
          .toISOString()
          .replace(/[:.]/g,'-');

      downloadText(
        `quorix-save-${stamp}.json`,
        JSON.stringify(
          data,
          null,
          2
        )
      );

      saveStatus.textContent =
        'Save exported.';

    } catch {

      saveStatus.textContent =
        'Export failed.';

    }

  }
);


importSaveBtn.addEventListener(
  'click',
  () => importSaveInput.click()
);


importSaveInput.addEventListener(
  'change',
  async () => {

    const file =
      importSaveInput.files &&
      importSaveInput.files[0];

    importSaveInput.value = '';

    if (!file) return;

    try {

      const raw =
        await file.text();

      const data =
        JSON.parse(raw);

      if (
        !data ||
        data.app !== 'Quorix' ||
        !Array.isArray(data.tabs)
      ) {

        throw new Error(
          'Invalid save file'
        );

      }


      const importedTabs =
        data.tabs.map(
          (t,i) => ({

            id:
              String(
                t.id ||
                `tab-${i + 1}`
              ),

            title:
              String(
                t.title ||
                'New Tab'
              ).slice(0,60),

            url:
              String(
                t.url || ''
              ),

            internal:
              Boolean(t.internal)

          })
        );


      tabs =
        importedTabs.length

          ? importedTabs

          : [
              {
                id:'tab-1',
                title:'New Tab',
                url:'',
                internal:false
              }
            ];


      tabCounter =
        Math.max(
          Number(data.tabCounter) || 0,
          tabs.length
        );


      activeTabId =
        tabs.some(
          t =>
            t.id ===
            String(data.activeTabId)
        )

          ? String(data.activeTabId)

          : tabs[0].id;


      if (data.theme) {

        applyTheme(
          data.theme
        );

      }


      /* Import history */

      if (
        Array.isArray(data.history)
      ) {

        quorixHistory =
          data.history
            .filter(
              item =>
                item &&
                item.url
            )
            .slice(0,100);

        saveHistory();

      }


      /* Import Quarktion */

      if (
        data.quarktion &&
        typeof data.quarktion === 'object'
      ) {

        qtChannelData =
          data.quarktion.channel ||
          null;

        qtVideos =
          Array.isArray(
            data.quarktion.videos
          )

            ? data.quarktion.videos

            : [];

        qtSaveChannel();

        qtSaveVideos();

        qtRenderGrid();

      }


      renderTabs();

      switchTab(
        activeTabId
      );

      saveStatus.textContent =
        'Save imported.';

    } catch {

      saveStatus.textContent =
        'Invalid Quorix JSON file.';

    }

  }
);


/* =========================================================
   BROWSER TABS
========================================================= */

const tabsBar =
  document.getElementById('tabsBar');

const newTabBtn =
  document.getElementById('newTabBtn');

let tabs = [];

let activeTabId = null;

let tabCounter = 0;


function tabTitle(v) {

  if (!v) {
    return 'New Tab';
  }

  if (
    v.startsWith('quorix://')
  ) {

    return v.slice(9);

  }

  try {

    return new URL(v)
      .hostname
      .replace(/^www\./,'')

      || 'Tab';

  } catch {

    return v.slice(0,22);

  }

}


function renderTabs() {

  tabsBar
    .querySelectorAll('.tab')
    .forEach(
      e => e.remove()
    );


  tabs.forEach(t => {

    const e =
      document.createElement('div');

    e.className =
      'tab' +
      (
        t.id === activeTabId
          ? ' active'
          : ''
      );


    const title =
      document.createElement('span');

    title.className =
      'tab-title';

    title.textContent =
      t.title;


    const c =
      document.createElement('button');

    c.className =
      'tab-close';

    c.type =
      'button';

    c.textContent =
      '×';

    c.title =
      'Close tab';


    c.onclick =
      x => {

        x.stopPropagation();

        closeTab(t.id);

      };


    e.append(
      title,
      c
    );


    e.onclick =
      () => switchTab(t.id);


    tabsBar.insertBefore(
      e,
      newTabBtn
    );

  });

}


function createTab() {

  const id =
    'tab-' +
    (++tabCounter);

  tabs.push({

    id,

    title:'New Tab',

    url:'',

    internal:false

  });

  activeTabId =
    id;

  renderTabs();

  showNewTabPage();

}


function showNewTabPage() {

  browserView.style.display =
    'none';

  home.style.display =
    'flex';

  hideQtube();

  siteFrame.src =
    'about:blank';

  searchInput.value =
    '';

  navStatus.textContent =
    '';

  searchInput.focus();

}


function switchTab(id) {

  const t =
    tabs.find(
      x => x.id === id
    );

  if (!t) return;

  activeTabId =
    id;

  renderTabs();


  if (!t.url) {

    showNewTabPage();

    return;

  }


  home.style.display =
    'none';

  browserView.style.display =
    'flex';


  if (t.internal) {

    showQtube();

  } else {

    navigate(
      t.url,
      true
    );

  }

}


function closeTab(id) {

  const i =
    tabs.findIndex(
      x => x.id === id
    );

  if (i < 0) return;


  const active =
    activeTabId === id;

  tabs.splice(
    i,
    1
  );


  if (!tabs.length) {

    createTab();

    return;

  }


  if (active) {

    activeTabId =
      tabs[
        Math.max(
          0,
          i - 1
        )
      ].id;

    switchTab(
      activeTabId
    );

  } else {

    renderTabs();

  }

}


newTabBtn.addEventListener(
  'click',
  createTab
);


/* =========================================================
   NAVIGATION
========================================================= */

const INTERNAL_ROUTES = {

  'quarktion.quorix':
    showQtube

};


function navigate(
  v,
  restoring = false
) {

  v =
    v.trim();

  if (!v) return;


  /* Add to history unless restoring an existing tab */

  if (!restoring) {

    addHistory(v);

  }


  hideQtube();


  const currentTab =
    tabs.find(
      t =>
        t.id ===
        activeTabId
    );


  if (
    currentTab &&
    !restoring
  ) {

    currentTab.url =
      v;

    currentTab.title =
      tabTitle(v);

    currentTab.internal =
      false;

    renderTabs();

  }


  const routeMatch =
    INTERNAL_ROUTES[
      v
        .toLowerCase()
        .replace(
          /^https?:\/\//i,
          ''
        )
        .replace(
          /\/$/,
          ''
        )
    ];


  if (routeMatch) {

    const currentTab =
      tabs.find(
        t =>
          t.id ===
          activeTabId
      );


    if (currentTab) {

      currentTab.url =
        'quorix://' +
        v
          .toLowerCase()
          .replace(
            /^https?:\/\//i,
            ''
          )
          .replace(
            /\/$/,
            ''
          );

      currentTab.title =
        tabTitle(
          currentTab.url
        );

      currentTab.internal =
        true;

      renderTabs();

    }


    home.style.display =
      'none';

    browserView.style.display =
      'flex';

    routeMatch();

    return;

  }


  const url =
    looksLikeUrl(v)

      ? (
          /^https?:\/\//i.test(v)
            ? v
            : 'https://' + v
        )

      : null;


  if (url) {

    /* .com websites open externally */

    try {

      const host =
        new URL(url)
          .hostname
          .toLowerCase();


      if (
        host.endsWith('.com')
      ) {

        window.open(
          url,
          '_blank',
          'noopener,noreferrer'
        );

        return;

      }

    } catch {}


    const currentTab =
      tabs.find(
        t =>
          t.id ===
          activeTabId
      );


    if (currentTab) {

      currentTab.url =
        url;

      currentTab.title =
        tabTitle(url);

      currentTab.internal =
        false;

      renderTabs();

    }


    addrText.textContent =
      url;

    openNewTab.href =
      url;

    home.style.display =
      'none';

    browserView.style.display =
      'flex';


    frameNote.textContent =
      'Loading…';


    let loaded = false;


    siteFrame.onload =
      () => {

        loaded = true;

        frameNote.textContent =
          '';

      };


    siteFrame.src =
      url;


    setTimeout(
      () => {

        if (!loaded) {

          frameNote.innerHTML =
            'This site blocks embedding on outside pages. ' +
            '<a href="' +
            url +
            '">Open it ↗</a>';

        }

      },
      2500
    );


  } else {

    addrText.textContent =
      'Search: ' + v;

    openNewTab.href =
      '#';

    siteFrame.src =
      'about:blank';

    frameNote.textContent =
      'Enter an embeddable website address, such as wikipedia.org or example.com.';

    home.style.display =
      'none';

    browserView.style.display =
      'flex';

  }

}


/* Search */

searchForm.addEventListener(
  'submit',
  e => {

    e.preventDefault();

    navigate(
      searchInput.value
    );

  }
);


/* Quick links */

document
  .querySelectorAll('.quicklink')
  .forEach(el => {

    el.addEventListener(
      'click',
      e => {

        e.preventDefault();

        navigate(
          el.dataset.url
        );

      }
    );

  });


/* Back */

backBtn.addEventListener(
  'click',
  () => {

    const t =
      tabs.find(
        x =>
          x.id ===
          activeTabId
      );


    if (t) {

      t.url =
        '';

      t.title =
        'New Tab';

      t.internal =
        false;

      renderTabs();

    }


    showNewTabPage();

  }
);


/* =========================================================
   START
========================================================= */

createTab();

</script>

