<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Quorix</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #F6F8F5;
    --ink: #16201C;
    --ink-soft: #4B5750;
    --accent: #2F6F5E;
    --accent-soft: #DCE7E1;
    --line: #CBD6CF;
    --surface: #FFFFFF;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #101511;
      --ink: #EAF0EA;
      --ink-soft: #9BAAA1;
      --accent: #6FBFA3;
      --accent-soft: #1B2620;
      --line: #2A342E;
      --surface: #161C18;
    }
  }

  :root[data-theme="dark"] {
    --bg: #101511;
    --ink: #EAF0EA;
    --ink-soft: #9BAAA1;
    --accent: #6FBFA3;
    --accent-soft: #1B2620;
    --line: #2A342E;
    --surface: #161C18;
  }

  :root[data-theme="midnight"] {
    --bg: #070A12;
    --ink: #EEF2FF;
    --ink-soft: #98A4C2;
    --accent: #7C8CFF;
    --accent-soft: #151B36;
    --line: #27304D;
    --surface: #0E1322;
  }

  :root[data-theme="ocean"] {
    --bg: #061218;
    --ink: #E8FBFF;
    --ink-soft: #8DB7C4;
    --accent: #27C7D9;
    --accent-soft: #0D2A31;
    --line: #1B414A;
    --surface: #0B1B22;
  }

  :root[data-theme="purple"] {
    --bg: #100A18;
    --ink: #F6EEFF;
    --ink-soft: #B8A8C9;
    --accent: #B77CFF;
    --accent-soft: #27153B;
    --line: #40275A;
    --surface: #181021;
  }

  :root[data-theme="sunset"] {
    --bg: #19100E;
    --ink: #FFF3EB;
    --ink-soft: #C9AFA2;
    --accent: #FF9A5A;
    --accent-soft: #3B2117;
    --line: #5A3326;
    --surface: #241613;
  }

  :root[data-theme="rose"] {
    --bg: #190D13;
    --ink: #FFF0F5;
    --ink-soft: #CBA9B6;
    --accent: #FF6F9F;
    --accent-soft: #3A1525;
    --line: #5B283D;
    --surface: #24121B;
  }

  :root[data-theme="forest"] {
    --bg: #08130E;
    --ink: #ECFBEF;
    --ink-soft: #9CB9A5;
    --accent: #67D48A;
    --accent-soft: #153322;
    --line: #294D36;
    --surface: #0E1D14;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
    margin: 0;
  }

  html {
    scroll-padding-top: env(safe-area-inset-top, 0px);
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    min-height: 100%;
    position: relative;
    overflow-x: hidden;
  }

  .grid-veil {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  #home {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 100vh;
    padding: 24px;
    position: relative;
    z-index: 1;
  }

  main {
    width: 100%;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mark {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: clamp(32px, 6vw, 44px);
    line-height: 1.15;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.6;
    max-width: 42ch;
    margin: 0 0 40px;
  }

  form.search {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 0 1px 2px rgba(20,30,25,0.04);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  form.search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  form.search svg {
    flex-shrink: 0;
    color: var(--ink-soft);
  }

  form.search input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 16px;
    color: var(--ink);
  }

  form.search input::placeholder {
    color: var(--ink-soft);
  }

  form.search button {
    border: none;
    background: var(--accent);
    color: var(--bg);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 9px;
    cursor: pointer;
  }

  form.search button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .traits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  .trait {
    font-size: 12.5px;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
  }

  .hint {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  .hint code {
    background: var(--accent-soft);
    padding: 2px 6px;
    border-radius: 5px;
  }

  .hint a.quicklink {
    color: var(--accent);
    text-decoration: none;
  }

  .hint a.quicklink:hover code {
    background: var(--accent);
    color: var(--bg);
  }

  #browser {
    display: none;
    flex-direction: column;
    height: 100vh;
    position: relative;
    z-index: 1;
    padding-top: 52px;
  }

  #home {
    position: relative;
    z-index: 1;
    padding-top: 52px;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: calc(14px + env(safe-area-inset-top, 0px)) 20px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  /* Browser tabs */
  .tabs-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    padding: 7px 170px 0 12px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    min-height: 45px;
    box-shadow: 0 2px 10px rgba(0,0,0,.06);
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 145px;
    max-width: 230px;
    height: 36px;
    padding: 0 7px 0 12px;
    border: 1px solid var(--line);
    border-bottom: none;
    border-radius: 9px 9px 0 0;
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
    user-select: none;
  }

  .tab.active {
    color: var(--ink);
    border-color: var(--accent);
    box-shadow: 0 -1px 0 var(--accent) inset;
  }

  .tab-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12.5px;
  }

  .tab-close {
    width: 22px;
    height: 22px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    font-size: 16px;
  }

  .tab-close:hover {
    background: var(--accent-soft);
    color: var(--ink);
  }

  .new-tab-btn {
    flex: 0 0 auto;
    width: 34px;
    height: 32px;
    margin: 0 0 4px 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    font-size: 20px;
  }

  .new-tab-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Top-right settings menu */
  .settings-dock {
    position: fixed;
    top: 7px;
    right: 12px;
    z-index: 140;
  }

  .settings-toggle {
    height: 34px;
    padding: 0 13px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface);
    color: var(--ink);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
    transition: .15s ease;
  }

  .settings-toggle:hover,
  .settings-toggle.active {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .settings-overlay,
  .history-overlay {
    position: fixed;
    inset: 0;
    z-index: 135;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0,0,0,.34);
    backdrop-filter: blur(5px);
  }

  .settings-overlay.open,
  .history-overlay.open {
    display: flex;
  }

  .settings-menu {
    width: min(440px,calc(100vw - 28px));
    max-height: min(78vh,620px);
    overflow: auto;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0,0,0,.24);
  }

  .settings-menu-head,
  .history-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .settings-menu h4,
  .history-menu h4 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .settings-close {
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: transparent;
    color: var(--ink);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .settings-close:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .settings-menu p {
    margin: 0 0 14px;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.5;
  }

  /* History settings button */
  .settings-history-section {
    margin-bottom: 16px;
  }

  .history-settings-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: .15s ease;
  }

  .history-settings-btn:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .history-settings-btn strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }

  .history-settings-btn small {
    display: block;
    margin-top: 3px;
    color: var(--ink-soft);
    font-size: 11px;
  }

  .history-settings-btn > span:last-child {
    font-size: 22px;
    color: var(--ink-soft);
  }

  .theme-options {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 8px;
  }

  .theme-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    transition: .15s ease;
  }

  .theme-option:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .theme-option.active {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    background: var(--accent-soft);
  }

  .theme-check {
    opacity: .35;
    font-weight: 600;
  }

  .theme-option.active .theme-check {
    opacity: 1;
    color: var(--accent);
  }

  /* ---------- History window ---------- */
  .history-menu {
    width: min(620px,calc(100vw - 28px));
    max-height: min(80vh,680px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 24px 70px rgba(0,0,0,.28);
  }

  .history-menu-head {
    margin-bottom: 12px;
  }

  .history-actions {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }

  .history-clear {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    border-radius: 8px;
    padding: 8px 11px;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .history-clear:hover {
    border-color: #d65b5b;
    color: #d65b5b;
    background: rgba(214,91,91,.08);
  }

  .history-list {
    overflow-y: auto;
    display: grid;
    gap: 7px;
    padding-right: 3px;
  }

  .history-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: .15s ease;
  }

  .history-item:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .history-icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
  }

  .history-info {
    min-width: 0;
    flex: 1;
  }

  .history-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 500;
  }

  .history-url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 2px;
    color: var(--ink-soft);
    font-size: 11px;
  }

  .history-time {
    flex: 0 0 auto;
    color: var(--ink-soft);
    font-size: 10px;
  }

  .history-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--ink-soft);
    font-size: 13px;
  }

  /* ---------- QuorixTube ---------- */
  .qtube {
    display: none;
    height: 100%;
    overflow-y: auto;
  }

  .qt-account {
    max-width: 360px;
    margin: 60px auto;
    padding: 28px;
    text-align: center;
  }

  .qt-account .qt-logo-lg {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .qt-account h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px;
    margin: 0 0 6px;
  }

  .qt-account p {
    color: var(--ink-soft);
    font-size: 13.5px;
    margin: 0 0 20px;
  }

  .qt-field {
    text-align: left;
    margin-bottom: 14px;
  }

  .qt-field label {
    display: block;
    font-size: 12px;
    color: var(--ink-soft);
    margin-bottom: 5px;
  }

  .qt-field input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 11px;
    font-family: inherit;
    font-size: 14px;
    color: var(--ink);
    background: var(--surface);
  }

  .qt-field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .qt-primary-btn {
    width: 100%;
    border: none;
    background: var(--accent);
    color: var(--bg);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    padding: 11px;
    border-radius: 9px;
    cursor: pointer;
  }

  .qtube-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 28px;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--surface);
  }

  .qtube-head .qt-logo {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .qtube-head .qt-logo svg {
    fill: var(--bg);
  }

  .qtube-head h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    margin: 0;
  }

  .qtube-head span {
    font-size: 12px;
    color: var(--ink-soft);
  }

  .qt-channel-controls {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .qt-nav-btn,
  .qt-studio-btn {
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-family: inherit;
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 999px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .qt-nav-btn.active {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--ink);
  }

  .qt-nav-btn:hover,
  .qt-studio-btn:hover {
    border-color: var(--accent);
  }

  .qt-view {
    display: none;
  }

  .qt-view.active {
    display: block;
  }

  .qt-search-panel {
    max-width: 900px;
    margin: 0 auto;
  }

  .qt-searchbar {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }

  .qt-searchbar input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 11px 13px;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
  }

  .qt-searchbar input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .qt-searchbar button {
    border: none;
    background: var(--accent);
    color: var(--bg);
    border-radius: 10px;
    padding: 0 15px;
    font: inherit;
    cursor: pointer;
  }

  .qt-search-results {
    display: grid;
    gap: 14px;
  }

  .qt-search-card {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 14px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .qt-search-card video,
  .qt-search-thumb-empty {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 9px;
    background: #000;
    object-fit: cover;
  }

  .qt-search-info {
    padding: 4px 2px;
  }

  .qt-search-info .qt-title {
    font-size: 15px;
  }

  .qt-search-info .qt-meta {
    margin-top: 4px;
  }

  .qt-body {
    padding: 24px 28px 34px;
  }

  .qt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill,minmax(220px,1fr));
    gap: 20px;
  }

  .qt-card video {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 10px;
    background: #000;
    margin-bottom: 8px;
  }

  .qt-thumb-empty {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 10px;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    color: var(--ink-soft);
    font-size: 12px;
    text-align: center;
    padding: 10px;
  }

  .qt-title {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 2px;
  }

  .qt-meta {
    font-size: 12px;
    color: var(--ink-soft);
    margin: 0;
  }

  .qt-overlay {
    position: fixed;
    inset: 45px 0 0 0;
    background: rgba(16,21,17,0.35);
    display: none;
    align-items: stretch;
    justify-content: flex-end;
